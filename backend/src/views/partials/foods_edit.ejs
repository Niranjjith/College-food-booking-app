<%- include('partials/header') %>
<h3><%= food ? 'Edit Food' : 'Create Food' %></h3>

<form method="post" action="<%= food ? '/admin/foods/' + food._id : '/admin/foods' %>">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Name</label>
      <input class="form-control" name="name" value="<%= food?.name || '' %>" required/>
    </div>
    <div class="col-md-6">
      <label class="form-label">Category</label>
      <input class="form-control" name="category" value="<%= food?.category || '' %>"/>
    </div>
    <div class="col-md-12">
      <label class="form-label">Description</label>
      <textarea class="form-control" name="description"><%= food?.description || '' %></textarea>
    </div>
    <div class="col-md-4">
      <label class="form-label">Price (₹)</label>
      <input class="form-control" name="price" type="number" step="0.01" value="<%= food?.price || '' %>" required/>
    </div>
    <div class="col-md-4">
      <label class="form-label">Image URL</label>
      <input class="form-control" name="imageUrl" value="<%= food?.imageUrl || '' %>"/>
    </div>
    <div class="col-md-4">
      <label class="form-label">Available</label>
      <select class="form-select" name="isAvailable">
        <option value="true" <%= food?.isAvailable ? 'selected' : '' %>>Yes</option>
        <option value="false" <%= food && !food.isAvailable ? 'selected' : '' %>>No</option>
      </select>
    </div>
  </div>
  <div class="mt-3">
    <button class="btn btn-success">Save</button>
    <a class="btn btn-secondary" href="/admin/foods">Cancel</a>
  </div>
</form>
<%- include('partials/footer') %>
